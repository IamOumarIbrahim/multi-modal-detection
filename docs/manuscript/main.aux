\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Experimental comparative evaluation pipeline of the MMSAR framework. Synchronized RGB and thermal streams are decimated to an 8~Hz operating timebase ($T_s = 125$~ms) and processed by parallel lightweight YOLOv5n backbones. A common scalar confidence cue $s[n] = \max (c_{\text  {RGB}}[n], c_{\text  {Thermal}}[n])$ is distributed identically across five competing causal temporal post-processing methods ($W = 5$ frames / 625~ms latency bound). Binary alarms are asserted against operational decision threshold $\tau = 0.5$ and evaluated across detection reliability and resource overhead.}}{5}{}\protected@file@percent }
\newlabel{fig:system_architecture}{{1}{5}{}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Temporal signal motivation ($W = 5$ frames = 625~ms) illustrating why temporal post-processing is required: (a) an isolated transient noise spike on a hard-negative scene triggers a spurious raw detection but is suppressed by causal temporal filtering ($y[n] = 0$), whereas (b) a sustained human victim signature confirms target presence and asserts the downstream alarm ($y[n] = 1$).}}{5}{}\protected@file@percent }
\newlabel{fig:temporal_postprocessing}{{2}{5}{}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {III-D}}Learned Selective State-Space Sequence Model (Mamba-SSSM)}{5}{}\protected@file@percent }
\citation{kyrkou2021emergencynet}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Empirical performance trade-off frontier comparing the five causal temporal post-processing methods. Raw frame-level baseline thresholding (M1) achieves high initial recall but zero false-alarm suppression, causing severe telemetry queueing and battery drain. Moving average (M2) suppresses clutter but incurs edge attenuation. Median filtering (M3) and history consensus (M4) establish strong noise rejection. Learned Mamba-SSSM (M5) defines the optimal Pareto frontier, achieving 89.4\% false-alarm suppression while preserving 95.8\% positive target recall.}}{6}{}\protected@file@percent }
\newlabel{fig:performance_tradeoff}{{3}{6}{}{figure.3}{}}
